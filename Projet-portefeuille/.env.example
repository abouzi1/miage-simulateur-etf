# ==============================================================================
# VARIABLES D'ENVIRONNEMENT (MODÈLE)
# ==============================================================================
# ATTENTION : Ne mettez jamais vos vrais mots de passe dans ce fichier !
# Copiez ce fichier, renommez-le en ".env" et remplacez les valeurs par les vôtres.

# ------------------------------------------------------------------------------
# BASE DE DONNÉES (PostgreSQL)
# ------------------------------------------------------------------------------
# Format : postgresql://[utilisateur]:[mot_de_passe]@[hôte]:[port]/[nom_base]

# Exemple si vous utilisez votre base locale (pgAdmin) :
DATABASE_URL=postgresql://postgres:VotreMotDePasseSecret@localhost:5432/portefeuille

# Exemple si vous utilisez la base cloud (Railway) :
# DATABASE_URL=postgresql://postgres:motdepasse_railway@viaduct.proxy.rlwy.net:12345/railway